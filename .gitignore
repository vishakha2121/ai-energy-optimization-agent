│   │   ├── components/               # Reusable UI
│   │   ├── pages/                    # Route pages
│   │   ├── hooks/                    # Custom hooks
│   │   ├── context/                  # React context
│   │   └── utils/                    # Helpers
│   └── public/                       # Static assets
│
├── database/                         # SQL schema + seed
├── docs/                             # Documentation
└── notebooks/                        # Jupyter experiments
```

